# Copy this file to .env and adjust values for your deployment.
# Sonora reads all configuration from environment variables — no config
# files, nothing hardcoded.

# --- Server ---
SONORA_HTTP_ADDR=:4533
SONORA_LOG_LEVEL=info

# --- Database ---
# Standard PostgreSQL connection string.
SONORA_DATABASE_URL=postgres://sonora:sonora@postgres:5432/sonora?sslmode=disable

# --- Auth ---
# Random secret used to sign native API JWTs. Generate with:
#   openssl rand -base64 32
SONORA_JWT_SECRET=changeme

# --- Library ---
# Path inside the container where the music library is mounted (read-only
# is fine except for the incoming/ subfolder used by the ingestion watcher).
SONORA_LIBRARY_PATH=/music
SONORA_INCOMING_PATH=/music/incoming

# Debounce window (seconds) the ingestion watcher waits after the last
# filesystem event before processing a file, to avoid reading partial
# copies.
SONORA_INGEST_DEBOUNCE_SECONDS=5

# --- Transcoding ---
# Directory used to cache transcoded audio before serving it again.
SONORA_TRANSCODE_CACHE_PATH=/cache
# Number of concurrent ffmpeg transcode workers.
SONORA_TRANSCODE_WORKERS=2

# --- Object storage (optional, for transcode cache offload) ---
# Leave blank to use local disk only (SONORA_TRANSCODE_CACHE_PATH).
SONORA_S3_ENDPOINT=
SONORA_S3_BUCKET=
SONORA_S3_ACCESS_KEY=
SONORA_S3_SECRET_KEY=

# --- Lyrics ---
# Fallback to the LRCLIB API when no local .lrc file is found next to the
# audio file. Set to false to keep lookups fully local/offline.
SONORA_LYRICS_LRCLIB_FALLBACK=true
